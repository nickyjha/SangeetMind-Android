    <!-- Opt-in accuracy survey (features/astrology/accuracy). -->
    <string name="survey_card_title">Help make readings more accurate</string>
    <string name="survey_card_body">Share a few facts about your life, anonymously, so we can check our verdicts against what really happened. Optional, about one minute.</string>
    <string name="survey_card_button">Take the 1-minute survey</string>
    <string name="survey_title">Accuracy survey</string>
    <string name="survey_close">Close</string>
    <string name="survey_intro">Every question is optional. Tap a choice again to clear it. Your answers are compared with the verdicts our engine gives for your chart, so we can see which classical rules hold up in real lives.</string>
    <string name="survey_privacy_title">How your answers are used</string>
    <string name="survey_privacy_body">We store your answers with your primary kundli\'s birth date, time and approximate location (rounded to about 1 km), but not your name. They are analysed only in aggregate, never shown to anyone, and never used for ads. You can withdraw at any time, and deleting your account deletes them too.</string>
    <string name="survey_consent">I agree to share these answers for accuracy research</string>
